---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Site from '../layouts/Site.astro';
import avatar from '../assets/landing/binu.png';
import { experience, certifications, links } from '../data/resume';

const featured = [
  { title: 'Audio Analysis Studio', href: '/myapps/audio-analysis-studio/', icon: 'lucide:audio-waveform', text: 'Distributed multi-engine audio intelligence stack for BPM tracking, Camelot keys, chords, and LUFS mastering inspection.' },
  { title: 'Event & Track Manager', href: '/myapps/event-track-manager/', icon: 'lucide:list-music', text: 'Cloud-native live stage production console with Google Workspace sync, automated audio intake, and real-time audience schedule.' },
  { title: 'Universal TTS Gateway', href: '/myapps/universal-tts/', icon: 'lucide:mic', text: 'OpenAI-compatible text-to-speech gateway with Edge-TTS, Piper and Kokoro engines and an in-memory LRU cache.' },
  { title: 'Image Optimizer for Web', href: '/myapps/image-optimizer-for-web/', icon: 'lucide:image-down', text: 'High-efficiency batch WebP converter with drag-and-drop compression presets and real-time size reduction metrics.' },
];

const stacks = [
  { title: 'Delivery & Analysis', items: [
    ['simple-icons:jira', 'Jira', 'agile planning, backlogs and reporting'],
    ['simple-icons:azuredevops', 'Azure DevOps', 'requirements, boards and pipelines'],
    ['simple-icons:postgresql', 'SQL & Teradata', 'data analysis and requirements testing'],
    ['simple-icons:tableau', 'Tableau', 'dashboards and data visualization'],
    ['lucide:chart-column', 'Power BI', 'business intelligence reporting'],
    ['simple-icons:figma', 'Figma', 'UI/UX prototyping'],
  ] },
  { title: 'Systems & Homelab', items: [
    ['simple-icons:github', 'GitHub', 'version control and CI/CD'],
    ['simple-icons:docker', 'Docker', 'containerized deployments'],
    ['simple-icons:proxmox', 'Proxmox VE', 'virtualization and hypervisors'],
    ['lucide:network', 'OpenWrt & VLANs', 'network segmentation', '/networking/openwrt-vlan/'],
    ['lucide:globe-lock', 'Caddy', 'reverse proxy with wildcard HTTPS', '/selfhosted/docker-compose/caddy/'],
    ['lucide:hard-drive', 'Linux & ZFS', 'storage, backups and administration', '/reference/linux/zfs-guide/'],
  ] },
  { title: 'AI & Agents', items: [
    ['simple-icons:claude', 'Claude Code', 'agentic coding and automation from the terminal'],
    ['simple-icons:googlegemini', 'Google Antigravity', 'autonomous multi-agent development'],
    ['lucide:bot', 'OpenClaw', 'AI agent orchestration and workflows', '/reference/ai/openclaw-tips/'],
    ['lucide:terminal', 'Pi Agent', 'extensible terminal coding and research', '/reference/ai/pi-agent/'],
    ['lucide:feather', 'Hermes Agent', 'reasoning and task execution'],
    ['lucide:message-square-code', 'Prompt engineering', 'techniques and reusable templates', '/promptengineering/essential-templates/'],
  ] },
];

const focus = [
  ['lucide:list-checks', 'Project delivery', 'PMP-certified, Scrum- and SAFe-trained. Plans that stay readable, with stakeholders who always know where things stand.'],
  ['lucide:search-check', 'Business analysis', 'Requirements, functional specs and UAT that turn vague asks into software that works, backed by SQL and process mapping.'],
  ['lucide:layout-dashboard', 'Product & data', 'Product ownership, Tableau dashboards and Figma prototypes designed so the right decision is the easy one.'],
];

const testimonials = [
  ['Binu\'s excellence at his job can be described in two ways: tenacity and passion. Few people commit so deeply to their work as Binu.', 'Koshy, Arun'],
  ['I worked with Binu on many projects. Binu has outstanding knowledge in Business Analysis methodologies and a great eye for design.', 'Singh, Inderjot'],
  ['Binu is an extremely talented designer of process. He always delivers superior results and is a great person to be around.', 'Thomas, Elson'],
];

const posts = (await getCollection('docs'))
  .filter((e) => e.id.startsWith('blog/') && e.data.date && !e.data.draft)
  .sort((a, b) => b.data.date!.valueOf() - a.data.date!.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const title = 'Binu Pradeep — Project Manager (PMP), builder, homelabber';
const description = 'PMP-certified Project Manager and Business Analyst in Philadelphia with 10+ years in healthcare and retail. Résumé, self-built apps, homelab guides and writing.';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Binu Pradeep', jobTitle: 'Project Manager',
  url: 'https://binupradeep.com', address: { '@type': 'PostalAddress', addressLocality: 'Philadelphia', addressRegion: 'PA' },
  sameAs: [links.linkedin, links.github, links.credly, links.tableau],
};
---
<Site title={title} description={description} path="/" jsonLd={jsonLd}>
  <main>
    <section class="hero">
      <p class="eyebrow">Project Manager · PMP® · Philadelphia, PA</p>
      <h1>I turn complex requirements into <em>products people use.</em></h1>
      <p class="lede">I work with companies to conceptualize, design, and create <strong>inclusive, effective, and impactful</strong> digital products. Ten-plus years delivering healthcare data, analytics and portal products as a Project Manager and Senior Business Systems Analyst.</p>
      <div class="cta">
        <a class="btn primary" href="/resume/">View résumé</a>
        <a class="btn" href={links.linkedin}>Connect on LinkedIn</a>
        <a class="btn" href="#projects">See what I build</a>
      </div>
      <dl class="facts">
        <div><dt>10+</dt><dd>years in delivery &amp; analysis</dd></div>
        <div><dt>{certifications.length}</dt><dd>professional certifications</dd></div>
        <div><dt>8</dt><dd>self-built apps</dd></div>
      </dl>
    </section>

    <section class="creds">
      <h2>Certified</h2>
      <ul class="chips">
        {certifications.filter((c) => c.featured).map((c) => <li title={`${c.name} · ${c.issued}`}>{c.short}</li>)}
      </ul>
      <p class="more"><a href={links.credly}>Verify on Credly →</a> · <a href={links.tableau}>Tableau Public portfolio →</a></p>
    </section>

    <section class="focus">
      <h2>What I do</h2>
      <div class="cards three">
        {focus.map(([icon, name, text]) => (
          <div class="card static">
            <Icon name={icon} size={22} />
            <h3>{name}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Experience</h2>
      <ol class="timeline">
        {experience.map((job) => (
          <li>
            <div class="role">
              <h3>{job.title}</h3>
              <span class="period">{job.period}</span>
            </div>
            <p class="ctx">{job.context}</p>
            <ul>
              {job.teams.flatMap((t) => t.points.slice(0, 2)).map((p) => <li>{p}</li>)}
            </ul>
          </li>
        ))}
      </ol>
      <p class="more"><a href="/resume/">Full résumé →</a></p>
    </section>

    <section>
      <h2>Kind words</h2>
      <div class="quotes">
        {testimonials.map(([q, who]) => (
          <blockquote><p>“{q}”</p><footer>— {who}</footer></blockquote>
        ))}
      </div>
    </section>

    <section class="about">
      <Image src={avatar} alt="Portrait of Binu Pradeep" width="150" height="150" class="avatar" />
      <div>
        <h2>About me</h2>
        <blockquote class="pull"><p>Minimalism and simplicity are the best tools to communicate your ideas to others.</p></blockquote>
        <ul>
          <li>I'm a Project Manager with a Business Analysis background, based in Philadelphia, PA, with over a decade in healthcare and retail.</li>
          <li>I design applications that line up with customer goals, using industry-leading tools for UI design, data analysis and visualization.</li>
          <li>Outside work: Docker, networking, automation and AI, plus singing, music, hiking, and football (watching, and playing on Xbox).</li>
        </ul>
      </div>
    </section>

    <section id="projects">
      <h2>Things I've built</h2>
      <p class="sub">I build and self-host the tools I wish existed. Each one is documented, with a Docker image or source on GitHub.</p>
      <div class="cards two">
        {featured.map((p) => (
          <a class="card" href={p.href}>
            <Icon name={p.icon} size={22} />
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </a>
        ))}
      </div>
      <p class="more"><a href="/myapps/universal-tts/">All projects →</a></p>
    </section>

    <section>
      <h2>Latest writing</h2>
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={`/${p.id.replace(/\.mdx?$/, '')}/`}>{p.data.title}</a>
            <time datetime={p.data.date!.toISOString()}>{fmt(p.data.date!)}</time>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/blog/">All posts →</a></p>
    </section>

    <section>
      <h2>Tools &amp; stack</h2>
      {stacks.map((s) => (
        <div class="stack">
          <h3>{s.title}</h3>
          <ul>
            {s.items.map(([icon, name, text, href]) => (
              <li>
                <Icon name={icon} size={20} />
                <div>
                  {href ? <a href={href}><strong>{name}</strong></a> : <strong>{name}</strong>}
                  <span>{text}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section id="contact" class="contact-block">
      <h2>Let's talk</h2>
      <p class="sub">Open to project conversations, collaborations and good homelab debates.</p>
      <a class="btn primary" href={`mailto:${links.email}`}><Icon name="lucide:mail" size={18} /> {links.email}</a>
      <ul class="contact">
        <li><a href={links.linkedin}><Icon name="simple-icons:linkedin" size={18} /> LinkedIn</a></li>
        <li><a href={links.github}><Icon name="simple-icons:github" size={18} /> GitHub</a></li>
        <li><a href="/resume/"><Icon name="lucide:file-text" size={18} /> Résumé</a></li>
      </ul>
    </section>
  </main>
</Site>
