---
// The photo in a hand-cut blob with an offset orange/ink shadow. Needs the #blobClip <clipPath> on the page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; class?: string; widths?: number[]; sizes?: string; loading?: 'eager' | 'lazy' }
const { src, alt, class: className = '', widths = [320, 480], sizes = '240px', loading = 'lazy' } = Astro.props;
---
<div class:list={['blobwrap', className]}>
  <div class="blob"><Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} /></div>
  <span class="dot d1" aria-hidden="true"></span><span class="dot d2" aria-hidden="true"></span>
</div>
