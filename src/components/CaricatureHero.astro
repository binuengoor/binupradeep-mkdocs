---
// The original hand-drawn caricature, untouched. The ink is drawn through a CSS mask so it takes the
// page's text colour: dark ink on the cream theme, light ink on the dark theme.
import ink from '../assets/landing/bp-hero-ink.svg';
---
<figure class="caricature">
  <div class="sketch" style={`--ink:url(${ink.src})`} role="img" aria-label="Hand-drawn caricature of Binu: swoop of hair, big ears, glasses, a goatee and a smirk."></div>
</figure>
