---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../styles/home.css';
import LogoFace from '../components/LogoFace.astro';

interface Props { title: string; description: string; path?: string; jsonLd?: object }
const { title, description, path = '/', jsonLd } = Astro.props;
const url = `https://binupradeep.com${path}`;
const ogImage = 'https://binupradeep.com/og.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Binu Pradeep" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Binu Pradeep — Project Manager, builder, homelabber" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Share the theme choice with the Starlight pages.
      const stored = localStorage.getItem('starlight-theme');
      const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <div id="prog" aria-hidden="true"></div>
    <header class="top">
      <a class="brand" href="/" aria-label="Binu Pradeep home">
        <LogoFace /> <span>Binu Pradeep</span>
      </a>
      <nav aria-label="Primary">
        <a href="/resume/">Résumé</a>
        <a href="/myapps/universal-tts/">Projects</a>
        <a href="/blog/">Writing</a>
        <a href="/networking/openwrt-vlan/">Networking</a>
        <a href="/selfhosted/docker-compose/caddy/">Self-Hosting</a>
        <a href="/reference/linux/zfs-guide/">Reference</a>
        <button id="theme" type="button" aria-label="Toggle theme">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8a2.83 2.83 0 0 0 4 4 4 4 0 1 1-4-4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.9 4.9 1.4 1.4"/><path d="m17.7 17.7 1.4 1.4"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.3 17.7-1.4 1.4"/><path d="m19.1 4.9-1.4 1.4"/></svg>
        </button>
      </nav>
    </header>
    <slot />
    <footer class="foot"><LogoFace /> © {new Date().getFullYear()} Binu Pradeep</footer>
    <script is:inline>
      document.getElementById('theme')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('starlight-theme', next); } catch {}
      });
    </script>
    <script>
      // Reading progress bar.
      const bar = document.getElementById('prog');
      const onScroll = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        if (bar) bar.style.width = max > 0 ? `${(h.scrollTop / max) * 100}%` : '0';
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // The logo's eyes follow the cursor and blink. Skipped for people who prefer reduced motion.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const faces = [...document.querySelectorAll<SVGSVGElement>('.face')];
        addEventListener('pointermove', (e) => {
          for (const f of faces) {
            const r = f.getBoundingClientRect();
            if (!r.width) continue;
            const s = r.width / 1024;
            f.querySelectorAll<SVGGElement>('.eye').forEach((g) => {
              const cx = r.left + Number(g.dataset.cx) * s;
              const cy = r.top + Number(g.dataset.cy) * s;
              const dx = e.clientX - cx, dy = e.clientY - cy;
              const d = Math.hypot(dx, dy) || 1;
              const m = Math.min(58, d / s / 6);
              g.querySelectorAll<SVGElement>('.pupil,.gleam').forEach((c) => {
                c.style.transform = `translate(${(dx / d) * m}px,${(dy / d) * m}px)`;
              });
            });
          }
        }, { passive: true });
        setInterval(() => {
          faces.forEach((f) => f.classList.add('blink'));
          setTimeout(() => faces.forEach((f) => f.classList.remove('blink')), 260);
        }, 3800);
      }
    </script>
  </body>
</html>
